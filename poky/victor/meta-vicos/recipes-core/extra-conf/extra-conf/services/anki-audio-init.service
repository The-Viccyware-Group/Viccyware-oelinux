[Unit]
SourcePath=/etc/initscripts/anki-audio-init
Description=Anki ALSA init
Wants=vic-robot.service init_audio.service
After=vic-robot.service init_audio.service
BindsTo=vic-robot.service

[Service]
Type=oneshot
IgnoreSIGPIPE=no
KillMode=process
RemainAfterExit=yes
ExecStart=/etc/initscripts/anki-audio-init
#Group=anki

[Install]
WantedBy=multi-user.target
